{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReviewGlass",
  "version": "0.1.0",
  "identifier": "app.sunrisesoftware.reviewglass",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "panel",
        "title": "ReviewGlass",
        "url": "/panel",
        "width": 900,
        "height": 640,
        "minWidth": 480,
        "minHeight": 320,
        "visible": false
      },
      {
        "label": "glass",
        "title": "ReviewGlass Glass",
        "url": "/glass",
        "width": 900,
        "height": 340,
        "minWidth": 160,
        "minHeight": 60,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "dock",
        "title": "ReviewGlass Dock",
        "url": "/dock",
        "width": 470,
        "height": 44,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false
      },
      {
        "label": "halo",
        "title": "ReviewGlass Halo",
        "url": "/halo",
        "width": 140,
        "height": 140,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false,
        "shadow": false
      },
      {
        "label": "finder",
        "title": "ReviewGlass Finder",
        "url": "/finder",
        "width": 400,
        "height": 200,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
